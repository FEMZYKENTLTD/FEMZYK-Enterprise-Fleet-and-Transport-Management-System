<?xml version="1.0" encoding="UTF-8"?>
<!--
    pom.xml — Maven Project Configuration
    Project: Femzyk Vehicle Rental System
    Package: com.femzyk.vehiclesystem
    Author:  Femzyk Enterprise Systems
    
    This file tells Maven:
    - What version of Java to use (17)
    - What dependencies/libraries the project needs
    - How to build and run the project
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Project Identity -->
    <groupId>com.femzyk</groupId>
    <artifactId>vehiclesystem</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <!-- Project Information -->
    <name>Femzyk Vehicle Rental System</name>
    <description>
        Enterprise Vehicle Information Management System
        CS 1102-01 Programming 1 - Unit 6 Assignment
    </description>

    <!-- Properties: Set Java version to 17 -->
    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <!-- Dependencies: External libraries your project uses -->
    <dependencies>

        <!-- JUnit 5: For unit testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- Build Configuration -->
    <build>
        <plugins>

            <!-- Maven Compiler Plugin: Compiles Java 17 code -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Maven Exec Plugin: Lets you run the program with mvn exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <!-- This tells Maven which class has the main() method -->
                    <mainClass>com.femzyk.vehiclesystem.VehicleRentalSystem</mainClass>
                </configuration>
            </plugin>

            <!-- Maven Jar Plugin: Creates a runnable JAR file -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.femzyk.vehiclesystem.VehicleRentalSystem</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>