# ---------------------------------------------------------------------------
# FEMZYK Fleet — web edition environment
# Copy to .env.local for local development, or add the same keys in Vercel
# Project ▸ Settings ▸ Environment Variables.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings ▸ API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Service-role key — SERVER ONLY. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random 32+ character string used to sign the session cookie.
# Generate with:  openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string

# One-time bootstrap/seed secret. Send it as the x-bootstrap-secret header to
# POST /api/bootstrap and POST /api/demo. Rotate or remove after first use.
BOOTSTRAP_SECRET=replace-with-a-long-random-string

# Demo mode: shows the demo account buttons on the sign-in page and seeds the
# demo accounts. Leave this off for anything that is not a public demo — it puts
# working credentials on the sign-in page.
DEMO_MODE=false

# Optional: application metadata shown in the UI
NEXT_PUBLIC_APP_VERSION=3.0.0
